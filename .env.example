# 数据库（docker compose 内部用 db 作为主机名）
DATABASE_URL=postgres://gradnavi:gradnavi@localhost:5432/gradnavi
POSTGRES_PASSWORD=gradnavi

# 会话签名密钥，生产环境用 `openssl rand -base64 32` 生成
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# 站点对外地址（生产填 https://你的域名）
BETTER_AUTH_URL=http://localhost:3000

# 发信 SMTP（Resend: smtps://resend:API_KEY@smtp.resend.com:465；阿里云邮件推送: smtps://账号:密码@smtpdm.aliyun.com:465）
# 开发环境留空时，验证码会打印在服务器日志里
SMTP_URL=
MAIL_FROM=GradNavi <no-reply@example.com>

# AI（DeepSeek）。留空时 AI 侧边栏使用演示模型（固定回复），不产生费用
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
# 检索/抓取服务地址（找教授用），一般不用改
# DEEPSEEK_TOOLS_URL=https://api.deepseek.com/v1/tools

# 仅生产：Caddy 自动申请 HTTPS 证书用的域名
DOMAIN=localhost

# PDF 导出用的 Chromium 路径。Docker 镜像里已安装，本地开发留空时自动找常见位置
CHROMIUM_PATH=

# ---- Credit 计量 ----
# 新用户注册赠送的 credit（1 credit 默认 = 0.001 美元成本）
SIGNUP_CREDITS=3000
# 成本价格表（美元）。⚠️ 默认按 DeepSeek 公开价估算，和 DeepSeek 后台账单核对后再改
# AI_PRICE_INPUT_PER_M=0.28
# AI_PRICE_CACHED_INPUT_PER_M=0.028
# AI_PRICE_OUTPUT_PER_M=0.42
# SEARCH_PRICE_PER_CALL=0.00075
# FETCH_PRICE_PER_CALL=0.00075
# 1 美元成本折合多少 credit、在成本上加价的倍数（1 = 按成本收）
# CREDITS_PER_USD=1000
# CREDIT_MARKUP=1

# ---- 内测 ----
# 能打开 /admin（成本统计、发 credit、邀请名单、反馈）的邮箱，逗号分隔
ADMIN_EMAILS=
# open = 任何邮箱都能注册；invite = 只有邀请名单内的新邮箱能注册（内测上线时用 invite）
SIGNUP_MODE=open
